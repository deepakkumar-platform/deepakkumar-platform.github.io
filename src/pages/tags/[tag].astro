---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, allTags, tagSlug } from '../../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return allTags(posts).map((t) => ({
    params: { tag: t.slug },
    props: { label: t.label, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === t.slug)) },
  }));
}
const { label, posts } = Astro.props;
---
<Base wide title={`Posts about ${label}`} description={`Everything Deepak Kumar has written about ${label}.`}>
  <header class="post-head">
    <h1>{label}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}. <a href="/articles/">See every topic</a></p>
  </header>
  <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
</Base>
