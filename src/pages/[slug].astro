---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPosts, longDate, readingMinutes, tagSlug, type Post } from '../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, image, tags } = post.data;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  datePublished: date.toISOString(), dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: 'Deepak Kumar', url: 'https://www.linkedin.com/in/deepakkumar2o' },
};
---
<Base title={title} description={description} image={image} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>, {readingMinutes(post.body)} min read
        {updated && <>. Updated {longDate(updated)}</>}
      </p>
      <p class="lede">{description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {tags.length > 0 && (
      <ul class="tags post-tags" aria-label="Topics">
        {tags.map((t) => <li><a href={`/tags/${tagSlug(t)}/`}>{t}</a></li>)}
      </ul>
    )}
  </article>
  <Newsletter />
  <nav class="pager" aria-label="More posts">
    {older ? <a href={`/${older.id}/`}><span>Older</span>{older.data.title}</a> : <span />}
    {newer && <a href={`/${newer.id}/`} style="text-align:right"><span>Newer</span>{newer.data.title}</a>}
  </nav>
</Base>
