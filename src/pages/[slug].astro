---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import { getPosts, longDate, readingMinutes, tagSlug, type Post } from '../lib';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter((h) => h.depth === 2);
const url = new URL(`/${post.id}/`, Astro.site).href;
const { title, description, date, updated, image, tags } = post.data;
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: title, description,
  datePublished: date.toISOString(), dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: 'Deepak Kumar', url: 'https://www.linkedin.com/in/deepakkumar2o' },
};
---
<Base title={title} description={description} image={image} type="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <article>
    <header class="post-head">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>, {readingMinutes(post.body)} min read
        {updated && <>. Updated {longDate(updated)}</>}
      </p>
      <p class="lede">{description}</p>
    </header>
    {sections.length >= 4 && (
      <details class="toc">
        <summary>In this post</summary>
        <ol>{sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <div class="prose">
      <Content />
    </div>
    {tags.length > 0 && (
      <ul class="tags post-tags" aria-label="Topics">
        {tags.map((t) => <li><a href={`/tags/${tagSlug(t)}/`}>{t}</a></li>)}
      </ul>
    )}
    <div class="share">
      <a class="button ghost" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">Share on LinkedIn</a>
      <button class="button ghost" type="button" data-copy={url}>Copy link</button>
      <span class="share-status" aria-live="polite"></span>
    </div>
  </article>
  <Newsletter />
  <script>
    const status = document.querySelector('.share-status');
    const say = (msg: string) => { if (status) { status.textContent = msg; setTimeout(() => (status.textContent = ''), 2500); } };
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
      try { await navigator.clipboard.writeText((e.currentTarget as HTMLElement).dataset.copy!); say('Link copied.'); }
      catch { say('Copy failed. Select the address bar and copy from there.'); }
    });
    // A copy button on every code block: readers paste commands straight into a terminal.
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const btn = Object.assign(document.createElement('button'), { type: 'button', className: 'copy-code', textContent: 'Copy' });
      btn.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText); btn.textContent = 'Copied'; }
        catch { btn.textContent = 'Copy failed'; }
        setTimeout(() => (btn.textContent = 'Copy'), 2000);
      });
      const wrap = document.createElement('div');
      wrap.className = 'code-wrap';
      pre.replaceWith(wrap);
      wrap.append(pre, btn);
    }
  </script>
  <nav class="pager" aria-label="More posts">
    {older ? <a href={`/${older.id}/`}><span>Older</span>{older.data.title}</a> : <span />}
    {newer && <a href={`/${newer.id}/`} style="text-align:right"><span>Newer</span>{newer.data.title}</a>}
  </nav>
</Base>
